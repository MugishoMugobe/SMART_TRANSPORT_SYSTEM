# Copy to .env for local production-mode testing, or set these in your
# hosting platform's dashboard. None of these are required for normal
# local development — settings.py falls back to the original dev
# defaults (DEBUG on, SQLite) when they're unset.

DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Namecheap / cPanel (MySQL — see docs/DEPLOYMENT.md):
# DATABASE_URL=mysql://cpaneluser_dbuser:password@localhost/cpaneluser_dbname
#
# Render / any host with Postgres:
# DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=
